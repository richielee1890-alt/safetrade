rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID_HERE'; }

    // All writes are done by the server (Netlify functions). Nobody can write from a browser.
    match /sellers/{phone}/deals/{id} { allow get, list: if true; allow write: if false; }
    match /{path=**}/deals/{id}      { allow read: if isAdmin(); }
    match /contacts/{id}             { allow read: if isAdmin(); allow write: if false; }
    match /{x=**}                    { allow read, write: if false; }
  }
}
